{
	"name": "metcomet",
	"version": "0.3.5",
	"description": "Meteora DLMM helper",
	"homepage": "https://github.com/qapquiz/metcomet#readme",
	"bugs": {
		"url": "https://github.com/qapquiz/metcomet/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/qapquiz/metcomet.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "bunup",
		"dev": "bunup --watch",
		"format": "oxfmt",
		"lint": "oxlint",
		"prepare": "bun simple-git-hooks",
		"release": "bumpp --commit --push --tag",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"test:watch": "bun test --watch",
		"type-check": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "^1.3.13",
		"bumpp": "^11.0.1",
		"bunup": "^0.16.31",
		"oxfmt": "^0.47.0",
		"oxlint": "^1.62.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^6.0.3"
	},
	"peerDependencies": {
		"typescript": ">=4.5.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"simple-git-hooks": {
		"pre-commit": "bun run lint && bun run type-check"
	},
	"dependencies": {
		"@coral-xyz/anchor": "^0.32.1",
		"@meteora-ag/dlmm": "^1.9.7",
		"@solana/web3.js": "^1.98.4"
	}
}
